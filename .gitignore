# Pre-write safety-copy backups accumulate over time and don't need to be
# version-controlled -- the git history of synthsworld.sqlite already
# captures the meaningful snapshots.
db/backups/

# Local admin-app auth token (fallback when the vault write fails) and its
# service logs -- never commit a live credential or log noise.
admin/.token
admin/admin.log
admin/admin.error.log

__pycache__/
*.pyc
